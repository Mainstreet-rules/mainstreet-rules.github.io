# The build compares bytes: tools/check.js fails if dist/ or docs/ does not
# match a fresh build. Line endings must therefore be identical on every
# machine, or a Windows checkout would produce CRLF output and a Linux CI
# runner would produce LF, and one of them would always "fail".
* text=auto eol=lf

# Never touch these.
*.png binary
*.jpg binary
*.webp binary
*.woff binary
*.woff2 binary
